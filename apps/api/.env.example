NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SCHEMA=public
DATABASE_SSL=false
# Production uses DATABASE_SSL=true and Render's supabase-ca.crt file.
# Set NODE_EXTRA_CA_CERTS=/etc/secrets/supabase-ca.crt in Render, not locally.
SUPABASE_URL=http://127.0.0.1:54321
# `pnpm infra:start` generates .env.local with the local Auth signing secret.
SUPABASE_JWT_SECRET=replace-with-local-jwt-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
